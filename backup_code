video = None

if chat:
    prompt = chat.text

    if chat.files:
        uploaded_file = chat.files[0]

        # Image
        if uploaded_file.type.startswith("image"):
            image = Image.open(uploaded_file)

        # Video
        elif uploaded_file.type.startswith("video"):
            video = uploaded_file

# Handle quick prompt buttons
if "selected_prompt" in st.session_state:
    prompt = st.session_state.pop("selected_prompt")

# Continue if there is either text or an image
if prompt or image or video:

    # Show user message
    with st.chat_message("user", avatar="🧑"):

        if image:
            st.image(image, width=250)

        if video:
            st.video(video, width=250)

        if prompt:
            st.markdown(prompt)

    # Save user message
    if prompt:
        message = prompt
    elif image:
        message = "[Image]"
    elif video:
        message = "[Video]"
    else:
        message = ""

    add_message(
        st.session_state.messages,
        "user",
        message
    )

    # Create chat title
    title = prompt if prompt else "Image Chat"

    if len(title) > 30:
        title = title[:30] + "..."

    if st.session_state.current_chat_index is None:

        st.session_state.chat_history.append({
            "title": title,
            "messages": []
        })

        save_history(st.session_state.chat_history)

        st.session_state.current_chat_index = (
            len(st.session_state.chat_history) - 1
        )

    # Update the cureent chat
    st.session_state.chat_history[
        st.session_state.current_chat_index
    ]["messages"] = st.session_state.messages.copy()

    save_history(st.session_state.chat_history)

    # Assistant response
    with st.chat_message("assistant", avatar="🤖"):

        placeholder = st.empty()
        full_response = ""

        try:
            with st.spinner("Thinking..."):

                # If image exists, send both image and prompt
                for chunk in stream_response(
                    st.session_state.chat,
                    prompt if prompt else "",
                    image,
                    video
                ):
                    full_response += chunk
                    placeholder.markdown(full_response + "▌")

            placeholder.markdown(full_response)

            add_message(
                st.session_state.messages,
                "assistant",
                full_response
            )

            # Update history
            st.session_state.chat_history[
            st.session_state.current_chat_index
            ]["messages"] = st.session_state.messages.copy()

            save_history(st.session_state.chat_history)

            st.rerun()

        except Exception as e:
            st.error(f"Error: {e}")
    
