def create_chat(temperature, top_p, top_k, max_tokens):
    generation_config = {
        "temperature": temperature,
        "top_p": top_p,
        "top_k": top_k,
        "max_output_tokens": max_tokens,
    }

    model = genai.GenerativeModel(
        model_name=MODEL_NAME,
        generation_config=generation_config,
    )

    return model.start_chat(history=[])


def stream_response(chat, prompt, image=None, video=None):
    
    try:
        if image is not None:
            response = chat.send_message(
                [prompt, image],
                stream=True
            )
        elif video is not None:
            response = chat.send_message(
                [prompt, video],
                stream=True
            )
        else:
            response = chat.send_message(
                prompt,
                stream=True
            )

        for chunk in response:
            text = getattr(chunk, "text", "")
            if text:
                yield text

    except Exception as e:
        raise RuntimeError(f"Gemini API Error: {e}")
    


from google import genai
from config import API_KEY, MODEL_NAME
from PIL import Image
import tempfile
import os

client = genai.Client(api_key=API_KEY)


def create_chat():
    chat = client.chats.create(
        model=MODEL_NAME
    )
    return chat


def stream_response(chat, prompt="", image=None, video=None):

    try:

        # ---------------- Image ----------------

        if image is not None:

            response = chat.send_message_stream(
                message=[prompt, image]
            )

        # ---------------- Video ----------------

        elif video is not None:

            suffix = os.path.splitext(video.name)[1]

            with tempfile.NamedTemporaryFile(
                delete=False,
                suffix=suffix
            ) as temp:

                temp.write(video.read())

                temp_path = temp.name

            uploaded_video = client.files.upload(
                file=temp_path
            )

            response = chat.send_message_stream(
                message=[
                    prompt,
                    uploaded_video
                ]
            )

        # ---------------- Text ----------------

        else:

            response = chat.send_message_stream(
                message=prompt
            )

        for chunk in response:

            if chunk.text:
                yield chunk.text

    finally:

        if video is not None:

            try:
                os.remove(temp_path)
            except:
                pass













